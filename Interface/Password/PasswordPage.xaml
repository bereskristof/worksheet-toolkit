<UserControl x:Class="Interface.Password.PasswordPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:res="clr-namespace:Interface.Resources"
             xmlns:settings="clr-namespace:Interface.Settings"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="300">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Button Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Margin="4" HorizontalAlignment="Right" VerticalAlignment="Top" Content="{x:Static res:Lang.Password_SettingsButton}" Click="SettingsButton_OnClick"/>
        <TabControl Grid.Column="1" Grid.Row="1" SelectionChanged="Selector_OnSelectionChanged"
                    MinWidth="300" MaxWidth="400" Padding="4, 4, 4, 4">
            <!-- BorderBrush="{DynamicResource {x:Static SystemColors.ScrollBarBrushKey}}" -->
            <!-- BorderThickness="1,1,1,1" Padding="4, 4, 4, 4" -->
            <TabItem Name="PasswordMode" Header="{x:Static res:Lang.Setup_Back}" IsSelected="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Label Grid.Row="0" Content="{x:Static res:Lang.Password_Label}" HorizontalAlignment="Left" Padding="0, 0, 0, 4" Margin="0"/>
                    <PasswordBox Grid.Row="1" Name="MainPasswordBox" PasswordChanged="MainPasswordBox_OnPasswordChanged"/>
                    <Button Grid.Row="2" Content="{x:Static res:Lang.Password_Enter}" Margin="0, 4, 0, 0" HorizontalAlignment="Right" Padding="4, 0" IsDefault="True" Click="ButtonLoadDb_OnClick"/>
                </Grid>
            </TabItem>
            <TabItem Name="ImportMode" Header="{x:Static res:Lang.Password_Change}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Label Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Content="{x:Static res:Lang.Import_Title}" HorizontalAlignment="Left" Padding="0, 0, 0, 4" Margin="0" FontWeight="Bold"/>
                    <Label Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Content="{x:Static res:Lang.Import_File}" HorizontalAlignment="Left" Padding="0, 0, 0, 4" Margin="0"/>
                    <TextBox Grid.Row="2" Grid.Column="0" Name="AddFileBox"/>
                    <Button Grid.Row="2" Grid.Column="1" Content="{x:Static res:Lang.Import_Browse}" HorizontalAlignment="Stretch" Padding="4, 0" Margin="4, 0, 0, 0" Click="ImportBrowse_OnClick"/>
                    <Button Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Content="{x:Static res:Lang.Import_Confirm}" Margin="0, 4, 0, 0" HorizontalAlignment="Right" Padding="4, 0" Click="ImportConfirm_OnClick"/>
                </Grid>
            </TabItem>
            <TabItem Name="CreateMode" Header="{x:Static res:Lang.Password_New}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Label Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Content="{x:Static res:Lang.Setup_Title}" HorizontalAlignment="Left" Padding="0, 0, 0, 4" Margin="0" FontWeight="Bold"/>
                    <Label Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Content="{x:Static res:Lang.Setup_File}" HorizontalAlignment="Left" Padding="0, 0, 0, 4" Margin="0"/>
                    <TextBox Grid.Row="2" Grid.Column="0" Name="NewFileBox"/>
                    <Button Grid.Row="2" Grid.Column="1" Content="{x:Static res:Lang.Setup_Browse}" Padding="4, 0" Margin="4, 0, 0, 0" Click="CreateBrowse_OnClick"/>
                    <Label Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Content="{x:Static res:Lang.Setup_Password}" HorizontalAlignment="Left" Padding="0, 0, 0, 4" Margin="0"/>
                    <PasswordBox Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Name="NewPasswordBox" PasswordChanged="NewPasswordBox_PasswordChanged" GotFocus="NewPasswordBox_GotFocus" LostFocus="NewPasswordBox_OnLostFocus"/>
                    <Button Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Content="{x:Static res:Lang.Setup_Confirm}" Margin="0, 4, 0, 0" HorizontalAlignment="Right" Padding="4, 0" Click="CreateConfirm_OnClick"/>
                </Grid>
            </TabItem>
        </TabControl>
        <!-- Since it loads too fast for an indeterminate bar, I just set an arbitrary value to force display the green part. -->
        <ProgressBar Grid.Column="1" Grid.Row="2" Name="LoadingBar" Value="20" Visibility="Hidden" Height="10" VerticalAlignment="Top" Margin="0, 4"/>
        <Label Grid.Column="1" Grid.Row="2" Content="{x:Static res:Lang.Password_Failure}" Name="IncorrectLabel" Visibility="Hidden"/>
        <Label Grid.Column="1" Grid.Row="2" Content="{x:Static res:Lang.Setup_Hint}" Name="PasswordHintLabel" Visibility="Hidden"/>
        <Border Width="300" Grid.Column="4" Grid.Row="0" Grid.RowSpan="4" Margin="0, 3, 3, 3" Name="SettingsBar" Visibility="Collapsed" Background="{DynamicResource {x:Static SystemColors.MenuBrushKey}}" BorderBrush="{DynamicResource {x:Static SystemColors.ScrollBarBrushKey}}" BorderThickness="1" Padding="4">
            <settings:SettingsPage/>
        </Border>
    </Grid>
</UserControl>
