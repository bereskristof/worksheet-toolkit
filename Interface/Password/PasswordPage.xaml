<UserControl x:Class="Interface.Password.PasswordPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:res="clr-namespace:Interface.Resources"
             xmlns:settings="clr-namespace:Interface.Settings"
             xmlns:root="clr-namespace:Interface"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="300">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Button Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Margin="4" Padding="4, 1"
                HorizontalAlignment="Right" VerticalAlignment="Top" Click="SettingsButton_OnClick">
            <root:IconLabel Text="{x:Static res:Lang.Password_SettingsButton}" Icon="&#xE713;"/>
        </Button>
        <TabControl Grid.Column="1" Grid.Row="1" SelectionChanged="Selector_OnSelectionChanged"
                    MinWidth="300" MaxWidth="400" Padding="4, 4, 4, 4">
            <!-- BorderBrush="{DynamicResource {x:Static SystemColors.ScrollBarBrushKey}}" -->
            <!-- BorderThickness="1,1,1,1" Padding="4, 4, 4, 4" -->
            <TabItem Name="PasswordMode" IsSelected="True">
                <TabItem.Header>
                    <root:IconLabel Text="{x:Static res:Lang.Setup_Back}" Icon="&#xE8A7;"/>
                </TabItem.Header>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Label Grid.Row="0" Content="{x:Static res:Lang.Password_Label}" HorizontalAlignment="Left" Padding="0, 0, 0, 4" Margin="0"/>
                    <PasswordBox Grid.Row="1" Name="MainPasswordBox" PasswordChanged="MainPasswordBox_OnPasswordChanged"/>
                    <Button Grid.Row="2" Margin="0, 4, 0, 0" HorizontalAlignment="Right" Padding="4, 0" IsDefault="True" Click="ButtonLoadDb_OnClick">
                        <root:IconLabel Text="{x:Static res:Lang.Password_Enter}" Icon="&#xE785;"/>
                    </Button>
                </Grid>
            </TabItem>
            <TabItem Name="ImportMode">
                <TabItem.Header>
                    <root:IconLabel Text="{x:Static res:Lang.Password_Change}" Icon="&#xE8B5;"/>
                </TabItem.Header>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Label Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Content="{x:Static res:Lang.Import_Title}" HorizontalAlignment="Left" Padding="0, 0, 0, 4" Margin="0" FontWeight="Bold"/>
                    <Label Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Content="{x:Static res:Lang.Import_File}" HorizontalAlignment="Left" Padding="0, 0, 0, 4" Margin="0"/>
                    <TextBox Grid.Row="2" Grid.Column="0" Name="AddFileBox"/>
                    <Button Grid.Row="2" Grid.Column="1" HorizontalAlignment="Stretch" Padding="4, 0" Margin="4, 0, 0, 0" Click="ImportBrowse_OnClick">
                        <root:IconLabel Text="{x:Static res:Lang.Common_Browse}" Icon="&#xE712;" IsIconOnly="True"/>
                    </Button>
                    <Button Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Margin="0, 4, 0, 0" HorizontalAlignment="Right" Padding="4, 0" Click="ImportConfirm_OnClick">
                        <root:IconLabel Text="{x:Static res:Lang.Import_Confirm}" Icon="&#xE8E5;"/>
                    </Button>
                </Grid>
            </TabItem>
            <TabItem Name="CreateMode">
                <TabItem.Header>
                    <root:IconLabel Text="{x:Static res:Lang.Password_New}" Icon="&#xE710;"/>
                </TabItem.Header>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Label Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Content="{x:Static res:Lang.Setup_Title}" HorizontalAlignment="Left" Padding="0, 0, 0, 4" Margin="0" FontWeight="Bold"/>
                    <Label Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Content="{x:Static res:Lang.Setup_File}" HorizontalAlignment="Left" Padding="0, 0, 0, 4" Margin="0"/>
                    <TextBox Grid.Row="2" Grid.Column="0" Name="NewFileBox"/>
                    <Button Grid.Row="2" Grid.Column="1" Padding="4, 0" Margin="4, 0, 0, 0" Click="CreateBrowse_OnClick">
                        <root:IconLabel Text="{x:Static res:Lang.Common_Browse}" Icon="&#xE712;" IsIconOnly="True"/>
                    </Button>
                    <Label Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Content="{x:Static res:Lang.Setup_Password}" HorizontalAlignment="Left" Padding="0, 0, 0, 4" Margin="0"/>
                    <PasswordBox Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Name="NewPasswordBox" PasswordChanged="NewPasswordBox_PasswordChanged" GotFocus="NewPasswordBox_GotFocus" LostFocus="NewPasswordBox_OnLostFocus"/>
                    <Button Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Margin="0, 4, 0, 0" HorizontalAlignment="Right" Padding="4, 0" Click="CreateConfirm_OnClick">
                        <root:IconLabel Text="{x:Static res:Lang.Setup_Confirm}" Icon="&#xE74E;"/>
                    </Button>
                </Grid>
            </TabItem>
        </TabControl>
        <!-- HACK: Since toggling visibility means it starts at a gray bar, opacity 0 is used for hidden instead. -->
        <ProgressBar Grid.Column="1" Grid.Row="2" Name="LoadingBar" IsIndeterminate="True" Height="10" VerticalAlignment="Top" Margin="0, 4" Opacity="0"/>
        <Label Grid.Column="1" Grid.Row="2" Content="{x:Static res:Lang.Password_Failure}" Name="IncorrectLabel" Visibility="Hidden"/>
        <Label Grid.Column="1" Grid.Row="2" Content="{x:Static res:Lang.Setup_Hint}" Name="PasswordHintLabel" Visibility="Hidden"/>
        <Border Width="300" Grid.Column="4" Grid.Row="0" Grid.RowSpan="4" Margin="0, 4, 4, 4" Name="SettingsBar" Visibility="Collapsed" Background="{DynamicResource {x:Static SystemColors.MenuBrushKey}}" BorderBrush="{DynamicResource {x:Static SystemColors.ScrollBarBrushKey}}" BorderThickness="1" Padding="4">
            <settings:SettingsPage/>
        </Border>
    </Grid>
</UserControl>
