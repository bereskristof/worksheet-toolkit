<UserControl x:Class="Interface.Solve.SolvePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:res="clr-namespace:Interface.Resources"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="300">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0" Visibility="Collapsed">
            
        </Grid>
        <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Width="5" Margin="3,0,3,0" Visibility="Collapsed"/>
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Label Grid.Column="0" Content="{x:Static res:Lang.Solve_CorrectLabel}" Padding="0"/>
                <TextBox Grid.Column="1" Margin="3, 0, 0, 0" Name="ImportPdfTextbox" TextChanged="ImportPdfTextbox_OnTextChanged"/>
                <Button Grid.Column="2" Content="{x:Static res:Lang.Common_Browse}" Click="ImportPdf_OnClick" Margin="3, 0, 0, 0" Padding="3, 0" Name="BrowseButton"/>
                <Button Grid.Column="3" Content="{x:Static res:Lang.Solve_Start}" Name="CorrectPdf" Click="CorrectPdf_OnClick" Margin="3, 0, 0, 0" Padding="3, 0" IsEnabled="False"/>
            </Grid>
            <Grid Grid.Row="1" Margin="0, 3, 0, 0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="{x:Static res:Lang.Solve_History}" Padding="3, 0" IsEnabled="False" Opacity="0.5"/>
                <Button Grid.Column="1" Content="{x:Static res:Lang.Solve_Get}" Click="ExportResults_OnClick" Name="ExportResultsButton" Padding="3, 0" Margin="3, 0, 0, 0" IsEnabled="False"/>
                <Button Grid.Column="2" Content="{x:Static res:Lang.Solve_GetAlt}" Click="ExportStats_OnClick" Name="ExportResultsAltButton" Padding="3, 0" Margin="3, 0, 0, 0" IsEnabled="False"/>
                <CheckBox Grid.Column="3" VerticalAlignment="Center" Content="{x:Static res:Lang.Solve_IncludeConfidence}" Name="ExtraInfoCheckbox" Padding="3, 0" Margin="3, 0, 0, 0"/>
            </Grid>
            <Border Grid.Row="2" Margin="0, 3, 0, 0" Background="#FFD" BorderBrush="#CC0"
                    BorderThickness="1,1,1,1" Name="InvalidPathWarningBox" Visibility="Collapsed">
                <Label Content="{x:Static res:Lang.Solve_InvalidFileWarning}"/>
            </Border>
            <ProgressBar Grid.Row="3" Height="10" Name="ProgressBar" VerticalAlignment="Top" Margin="3, 11, 3, 3"/>
            <DataGrid Grid.Row="4" GridLinesVisibility="None" SelectionMode="Single" BorderThickness="0"
                      Background="Transparent" CanUserResizeRows="False" RowHeaderWidth="0" IsReadOnly="True"
                      HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Name="ResultsTable">
                <!-- Styling -->
                <DataGrid.Resources>
                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="LightBlue" />
                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}"
                                     Color="LightBlue" />
                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="Black" />
                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}"
                                     Color="Black" />
                </DataGrid.Resources>
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="{x:Type DataGridColumnHeader}">
                        <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.MenuBrushKey}}" />
                        <Setter Property="BorderBrush"
                                Value="{DynamicResource {x:Static SystemColors.ScrollBarBrushKey}}" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Setter Property="Padding" Value="4, 2" />
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.RowStyle>
                    <Style TargetType="{x:Type DataGridRow}">
                        <Setter Property="BorderThickness" Value="0, 0, 0, 1" />
                        <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.MenuBrushKey}}" />
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.CellStyle>
                    <Style TargetType="{x:Type DataGridCell}">
                        <Style.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="Background" Value="LightBlue" />
                                <Setter Property="BorderThickness" Value="1" />
                                <Setter Property="BorderBrush" Value="LightBlue" />
                            </Trigger>
                            <Trigger Property="IsEditing" Value="True">
                                <Setter Property="Background" Value="LightBlue" />
                                <Setter Property="BorderThickness" Value="1" />
                                <Setter Property="BorderBrush" Value="LightBlue" />
                            </Trigger>
                            <DataTrigger Binding="{Binding MinorError}" Value="True">
                                <Setter Property="Foreground" Value="DarkGoldenrod"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding MajorError}" Value="True">
                                <Setter Property="Foreground" Value="Brown"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.CellStyle>
                <!-- Styling -->
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{x:Static res:Lang.Solve_HeaderPage}" Binding="{Binding Page}" Width="Auto"/>
                    <DataGridTextColumn Header="{x:Static res:Lang.Solve_HeaderState}" Binding="{Binding StateString}" Width="Auto"/>
                    <DataGridTextColumn Header="{x:Static res:Lang.Solve_HeaderNeptun}" Binding="{Binding UserCode}" Width="Auto"/>
                    <DataGridTextColumn Header="{x:Static res:Lang.Solve_HeaderSuccess}" Binding="{Binding Result}" Width="Auto"/>
                    <DataGridTextColumn Header="{x:Static res:Lang.Solve_HeaderTotal}" Binding="{Binding TotalPoints}" Width="Auto"/>
                    <DataGridTextColumn Header="{x:Static res:Lang.Solve_HeaderReset}" Width="Auto"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</UserControl>
