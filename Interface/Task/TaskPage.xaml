<UserControl x:Class="Interface.Task.TaskPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:res="clr-namespace:Interface.Resources"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="300">
    <!-- xmlns:math="clr-namespace:WpfMath.Controls;assembly=WpfMath" -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <DataGrid Grid.Row="0" Grid.ColumnSpan="4" Name="TaskList" ItemsSource="{Binding}"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      SelectionChanged="TaskList_OnSelectionChanged" GridLinesVisibility="None" SelectionMode="Single"
                      HorizontalScrollBarVisibility="Disabled"
                      BorderThickness="0" Background="Transparent" CanUserResizeRows="False" RowHeaderWidth="0"
                      KeyboardNavigation.TabNavigation="None" KeyboardNavigation.IsTabStop="False">
                <!-- Styling -->
                <DataGrid.Resources>
                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="LightBlue" />
                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}"
                                     Color="LightBlue" />
                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="Black" />
                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}"
                                     Color="Black" />
                </DataGrid.Resources>
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="{x:Type DataGridColumnHeader}">
                        <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.MenuBrushKey}}" />
                        <Setter Property="BorderBrush"
                                Value="{DynamicResource {x:Static SystemColors.ScrollBarBrushKey}}" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Setter Property="Padding" Value="4, 2" />
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.RowStyle>
                    <Style TargetType="{x:Type DataGridRow}">
                        <Setter Property="BorderThickness" Value="0, 0, 0, 1" />
                        <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.MenuBrushKey}}" />
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.CellStyle>
                    <Style TargetType="{x:Type DataGridCell}">
                        <Style.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="Background" Value="LightBlue" />
                                <Setter Property="BorderThickness" Value="1" />
                                <Setter Property="BorderBrush" Value="LightBlue" />
                            </Trigger>
                            <Trigger Property="IsEditing" Value="True">
                                <Setter Property="Background" Value="LightBlue" />
                                <Setter Property="BorderThickness" Value="1" />
                                <Setter Property="BorderBrush" Value="LightBlue" />
                            </Trigger>
                            <DataTrigger Binding="{Binding FailedToDecrypt}" Value="True">
                                <Setter Property="Foreground" Value="Brown"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.CellStyle>
                <!-- Styling -->
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="30" />
                    <DataGridTextColumn Header="{x:Static res:Lang.Task_Question}" Binding="{Binding Text}" Width="*" />
                    <!--     <DataGridTextColumn Header="Answers" Binding="{Binding (storage:Question.AnswerCount)}" Width="55"/> -->
                </DataGrid.Columns>
            </DataGrid>
            <Button Grid.Row="1" Grid.Column="2" Content="{x:Static res:Lang.Task_Add}" Click="ButtonAdd_OnClick"
                    Margin="0, 3, 3, 0" Padding="4,1,4,1" HorizontalAlignment="Right" />
            <Button Grid.Row="1" Grid.Column="3" Content="{x:Static res:Lang.Task_Delete}" Click="ButtonDelete_OnClick"
                    Margin="0, 3, 0, 0" Padding="4,1,4,1" HorizontalAlignment="Right" />
        </Grid>
        <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Width="5" Margin="3,0,0,0" />
        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="72" />
                    <ColumnDefinition Width="48" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /> <!-- <RowDefinition Height="200"/> -->
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <!-- <math:FormulaControl Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="0" Formula="23 + \frac{9}{99}" HorizontalAlignment="Center" VerticalAlignment="Center"/> -->
                <!-- <GridSplitter Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="1" VerticalAlignment="Stretch" Height="5" HorizontalAlignment="Stretch"/> -->
                <ProgressBar Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Height="10" IsIndeterminate="True" Name="ImageProgressBar" Visibility="Collapsed" Margin="3,0,0,3" />
                <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                        Background="{DynamicResource {x:Static SystemColors.MenuBrushKey}}"
                        BorderBrush="{DynamicResource {x:Static SystemColors.ScrollBarBrushKey}}"
                        BorderThickness="1,1,1,1" Padding="3" MaxHeight="400" Margin="3, 0, 0, 3"
                        Visibility="Collapsed" Name="ImagePanel">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Label Grid.Row="0" Grid.Column="0" Content="{x:Static res:Lang.Task_ImageLabel}" FontStyle="Italic" Padding="4, 0" />
                        <Button Grid.Row="0" Grid.Column="1" Content="{x:Static res:Lang.Task_ImageDelete}" HorizontalAlignment="Right" 
                                Padding="4, 0" Click="ButtonDeleteImage_OnClick"/>
                        <Image Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Name="ImagePreview" Margin="3" MaxHeight="370" />
                    </Grid>
                </Border>
                <TextBlock Grid.Column="0" Grid.Row="2" Text="{x:Static res:Lang.Task_QuestionLabel}"
                           HorizontalAlignment="Right" VerticalAlignment="Top" Padding="0,0,6,0" />
                <TextBox Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="2" TextWrapping="WrapWithOverflow"
                         AcceptsReturn="True" Name="QuestionBox" Text="{Binding Path=.}" IsEnabled="False" />
                <TextBlock Grid.Column="0" Grid.Row="3" Text="{x:Static res:Lang.Task_Score}"
                           HorizontalAlignment="Right" VerticalAlignment="Top" Padding="0,0,6,0" Margin="0,3,0,0"  Visibility="Hidden" />
                <TextBox Grid.Column="1" Grid.Row="3" Margin="0,3,0,0" Name="ScoreBox" Text="{Binding Path=.}"
                         IsEnabled="False" Visibility="Hidden"/> <!-- TODO: Properly remove this -->
                <Button Grid.Column="2" Grid.Row="3" Name="ImageButton" Content="{x:Static res:Lang.Task_Image}"
                        Margin="3, 3, 0, 0" HorizontalAlignment="Right" Click="ImageButton_OnClick" Padding="4,0,4,0"
                        IsEnabled="False" />
                <TextBlock Grid.Column="2" Grid.Row="3" Margin="3,3,0,0" Text="LqScoreError" Visibility="Hidden"
                           Name="ScoreErrorText" />
                <TextBlock Grid.Column="0" Grid.Row="4" Text="{x:Static res:Lang.Task_Answers}"
                           HorizontalAlignment="Right" VerticalAlignment="Top" Padding="0,0,6,0" Margin="0,3,0,0" />
                <DataGrid Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="4" Name="AnswerListPanel"
                          ItemsSource="{Binding}" GridLinesVisibility="None" SelectionMode="Single"
                          HorizontalScrollBarVisibility="Disabled" AutoGenerateColumns="False" Margin="0,3,0,0"
                          BorderThickness="0" Background="Transparent" CanUserResizeRows="False" RowHeaderWidth="0">
                    <!-- Styling -->
                    <DataGrid.Resources>
                        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}"
                                         Color="LightBlue" />
                        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}"
                                         Color="Black" />
                    </DataGrid.Resources>
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="{x:Type DataGridColumnHeader}">
                            <Setter Property="Background"
                                    Value="{DynamicResource {x:Static SystemColors.MenuBrushKey}}" />
                            <Setter Property="BorderBrush"
                                    Value="{DynamicResource {x:Static SystemColors.ScrollBarBrushKey}}" />
                            <Setter Property="BorderThickness" Value="1" />
                            <Setter Property="Padding" Value="4, 2" />
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.RowStyle>
                        <Style TargetType="{x:Type DataGridRow}">
                            <Setter Property="BorderThickness" Value="0, 0, 0, 1" />
                            <Setter Property="BorderBrush"
                                    Value="{DynamicResource {x:Static SystemColors.MenuBrushKey}}" />
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.CellStyle>
                        <Style TargetType="{x:Type DataGridCell}">
                            <Style.Triggers>
                                <Trigger Property="IsFocused" Value="True">
                                    <Setter Property="Background" Value="{x:Static SystemColors.HighlightBrush}" />
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Setter Property="BorderBrush" Value="{x:Static SystemColors.HighlightBrush}" />
                                </Trigger>
                                <Trigger Property="IsEditing" Value="True">
                                    <Setter Property="Background" Value="{x:Static SystemColors.HighlightBrush}" />
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Setter Property="BorderBrush" Value="{x:Static SystemColors.HighlightBrush}" />
                                </Trigger>
                                <DataTrigger Binding="{Binding FailedToDecrypt}" Value="True">
                                    <Setter Property="Foreground" Value="Brown"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.CellStyle>
                    <!-- Styling -->
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="{x:Static res:Lang.Task_AnswerCorrect}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox
                                        IsChecked="{Binding Correct, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="{x:Static res:Lang.Task_Answer}" Binding="{Binding Text}" Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style>
                                    <Setter Property="TextBlock.TextWrapping" Value="Wrap" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <!--     <DataGridTextColumn Header="Answers" Binding="{Binding (storage:Question.AnswerCount)}" Width="55"/> -->
                    </DataGrid.Columns>
                </DataGrid>
                <Grid Grid.Column="0" Grid.Row="5" Grid.ColumnSpan="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="1" HorizontalAlignment="Right" Content="{x:Static res:Lang.Task_AddAnswer}"
                            Margin="0, 3, 3, 0" Padding="4,1,4,1" Click="ButtonAddAnswer_OnClick"
                            Name="AnswerAddButton" IsEnabled="False" />
                    <Button Grid.Column="2" HorizontalAlignment="Right" Content="{x:Static res:Lang.Task_DeleteAnswer}"
                            Margin="0, 3, 0, 0" Padding="4,1,4,1" Click="ButtonDeleteAnswer_OnClick"
                            Name="AnswerDeleteButton" IsEnabled="False" />
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>