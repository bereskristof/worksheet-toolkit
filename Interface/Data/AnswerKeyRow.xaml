<UserControl x:Class="Interface.Data.AnswerKeyRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="300">
    <Grid VerticalAlignment="Top">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Label Grid.Column="0" Content="1. A" FontFamily="Lucida Console" VerticalAlignment="Center" Padding="3, 2, 3, 0" Name="RowLabel"/>
        <RadioButton Grid.Column="1" VerticalAlignment="Center" IsEnabled="False" Name="ButtonA"/>
        <RadioButton Grid.Column="2" VerticalAlignment="Center" IsEnabled="False" Name="ButtonB"/>
        <RadioButton Grid.Column="3" VerticalAlignment="Center" IsEnabled="False" Name="ButtonC"/>
        <RadioButton Grid.Column="4" VerticalAlignment="Center" IsEnabled="False" Name="ButtonD"/>
        <RadioButton Grid.Column="5" VerticalAlignment="Center" IsEnabled="False" Name="ButtonE"/>
    </Grid>
</UserControl>
