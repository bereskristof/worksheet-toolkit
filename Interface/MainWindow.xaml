<Window x:Class="Interface.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:password="clr-namespace:Interface.Password"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        Title="Worksheet Toolkit" Height="800" Width="1200">
    <DockPanel UseLayoutRounding="True">
        <Grid Name="Main">
            <password:PasswordPage x:Name="PasswordEntry" PasswordUnlocked="PasswordEntry_OnPasswordUnlocked"/>
        </Grid>
    </DockPanel>
</Window>
