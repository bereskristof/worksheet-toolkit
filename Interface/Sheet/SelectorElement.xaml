<UserControl x:Class="Interface.Sheet.SelectorElement"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:res="clr-namespace:Interface.Resources"
             xmlns:root="clr-namespace:Interface"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="300">
    <Grid>
        <Border Background="{DynamicResource {x:Static SystemColors.MenuBrushKey}}" BorderBrush="{DynamicResource {x:Static SystemColors.ScrollBarBrushKey}}" Margin="0,3,0,0" BorderThickness="1,1,1,1" Padding="4,4,4,4" VerticalAlignment="Top" Name="MainBorder">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Static res:Lang.Sheet_ContainerTitle}" FontStyle="Italic" Name="TitleTextBlock" VerticalAlignment="Center" Padding="0"/>
                <Grid Grid.Row="0" Grid.Column="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox Grid.Column="0" HorizontalAlignment="Stretch" Name="BehaviourBox" Padding="4, 0">
                        <ComboBoxItem Content="{x:Static res:Lang.Sheet_OptionListShuffled}" IsSelected="True" Selected="OptionListShuffled_OnSelected"/>
                        <ComboBoxItem Content="{x:Static res:Lang.Sheet_OptionListOrdered}" Selected="OptionListOrdered_OnSelected"/>
                        <ComboBoxItem Content="{x:Static res:Lang.Sheet_OptionPickRandom}" Selected="OptionPickShuffled_OnSelected"/>
                    </ComboBox>
                    <Button Grid.Column="1" Margin="3, 0, 0,0" Padding="4, 0" Click="ButtonHide_OnClick" Name="HideButton">
                        <Grid>
                            <root:IconLabel x:Name="HideButtonLabel" Text="{x:Static res:Lang.Sheet_Hide}" Icon="&#xE8C5;" IsIconOnly="True"/>
                            <root:IconLabel x:Name="ShowButtonLabel" Text="{x:Static res:Lang.Sheet_Show}" Icon="&#xE8C4;" IsIconOnly="True" Visibility="Collapsed"/>
                        </Grid>
                    </Button>
                </Grid>
                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Name="ContentList"/>
                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0, 3, 0,0" Name="ManageButtons" HorizontalAlignment="Right">
                    <Button Padding="4, 0" Click="ButtonAddTask_OnClick">
                        <root:IconLabel x:Name="AddQuestionButtonLabel" Text="{x:Static res:Lang.Sheet_AddQuestion}" Icon="&#xE710;" IsIconOnly="True"/>
                    </Button>
                    <Button Margin="3, 0, 0,0" Padding="4, 0" Click="ButtonAddContainer_OnClick">
                        <root:IconLabel x:Name="AddGroupButtonLabel" Text="{x:Static res:Lang.Sheet_AddContainer}" Icon="&#xE82E;" IsIconOnly="True"/>
                    </Button>
                    <Button Margin="3, 0, 0,0" Padding="4, 0" Click="ButtonDelete_OnClick" Name="DeleteButton">
                        <root:IconLabel Text="{x:Static res:Lang.Sheet_Delete}" Icon="&#xE74D;" IsIconOnly="True"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
